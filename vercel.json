{
    "version": 2,
    "functions": {
        "api/**/*.php": {
            "runtime": "vercel-php@0.7.3",
            "includeFiles": [
                "public/**/*.php",
                "public/components/**"
            ]
        }
    },
    "routes": [
        {
            "src": "/(assets|css|js|components)/(.*)",
            "dest": "/public/$1/$2"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}